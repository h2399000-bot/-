rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // General website settings
    match /settings/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Programs and courses
    match /programs/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Notices and news
    match /notices/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Consulting requests
    match /consulting_requests/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    
    // Contact inquiries
    match /inquiries/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    
    // Program registrations / applications
    match /applications/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
